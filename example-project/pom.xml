<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>in.virit.iot</groupId>
    <artifactId>pi-starter</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>Pi Starter</name>
    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <quarkus.version>3.37.2</quarkus.version>
        <vaadin.version>25.3.0</vaadin.version>
        <pi4j.version>4.0.2</pi4j.version>
        <viritin.version>3.9.0</viritin.version>
        <pi-helpers.version>1.0.0-SNAPSHOT</pi-helpers.version>
        <simulation.skipTestSources>false</simulation.skipTestSources>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.vaadin</groupId>
                <artifactId>vaadin-bom</artifactId>
                <version>${vaadin.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <dependency>
            <groupId>in.virit.iot</groupId>
            <artifactId>pi-helpers</artifactId>
            <version>${pi-helpers.version}</version>
        </dependency>
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-quarkus-extension</artifactId>
            <version>${vaadin.version}</version>
        </dependency>
        <dependency>
            <groupId>in.virit</groupId>
            <artifactId>viritin</artifactId>
            <version>${viritin.version}</version>
        </dependency>
        <!-- Hardware dependencies are used only by the LED example. -->
        <dependency>
            <groupId>com.pi4j</groupId>
            <artifactId>pi4j-core</artifactId>
            <version>${pi4j.version}</version>
        </dependency>
        <dependency>
            <groupId>com.pi4j</groupId>
            <artifactId>pi4j-plugin-ffm</artifactId>
            <version>${pi4j.version}</version>
        </dependency>
        <!-- The BME280 example: the sensor driver plus the gauge and sparkline the
             climate card is drawn with (the same ones ScrewCloud's pi-reader uses). -->
        <dependency>
            <groupId>com.pi4j</groupId>
            <artifactId>pi4j-drivers</artifactId>
            <version>1.1.0</version>
        </dependency>
        <dependency>
            <groupId>in.virit</groupId>
            <artifactId>gauge</artifactId>
            <version>1.3.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>in.virit</groupId>
            <artifactId>svg-visualizations</artifactId>
            <version>1.2.0-SNAPSHOT</version>
        </dependency>
        <!-- Publishing to Home Assistant: MQTT client and mDNS lookup of the instance. -->
        <dependency>
            <groupId>com.hivemq</groupId>
            <artifactId>hivemq-mqtt-client</artifactId>
            <version>1.4.0</version>
        </dependency>
        <dependency>
            <groupId>org.jmdns</groupId>
            <artifactId>jmdns</artifactId>
            <version>3.6.3</version>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-validator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Tests run against simulated hardware; the test jar has the browserless test base. -->
        <dependency>
            <groupId>in.virit.iot</groupId>
            <artifactId>pi-helpers-simulation</artifactId>
            <version>${pi-helpers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>in.virit.iot</groupId>
            <artifactId>pi-helpers-simulation</artifactId>
            <version>${pi-helpers.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <!-- Browserless UI tests: real views in a mocked Vaadin environment inside the
             Quarkus test container, no browser and no frontend build. -->
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>browserless-test-quarkus</artifactId>
            <version>1.1.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>1.62.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <pluginRepositories>
        <!-- svg-render-maven-plugin is only published as a snapshot so far. -->
        <pluginRepository>
            <id>central-snapshots</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
            <releases><enabled>false</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </pluginRepository>
    </pluginRepositories>
    <profiles>
        <!-- Build against a locally installed Pi4J from the fork's my-main branch. -->
        <profile>
            <id>pi4j-local</id>
            <properties><pi4j.version>5.0.0-mstahv-SNAPSHOT</pi4j.version></properties>
        </profile>
        <profile>
            <id>simulation</id>
            <properties>
                <!-- These sources are already compiled as application classes in this profile. -->
                <simulation.skipTestSources>true</simulation.skipTestSources>
            </properties>
            <dependencies>
                <!-- Simulated GPIO, I2C, PWM, 1-Wire and BLE for the pi-helpers services. -->
                <dependency>
                    <groupId>in.virit.iot</groupId>
                    <artifactId>pi-helpers-simulation</artifactId>
                    <version>${pi-helpers.version}</version>
                </dependency>
            </dependencies>
            <build>
                <!-- Never leave simulated application classes in the production output tree. -->
                <directory>target/simulation</directory>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>simulation-dev-sources</id>
                                <phase>generate-sources</phase>
                                <goals><goal>add-source</goal></goals>
                                <configuration>
                                    <sources><source>src/simulation/java</source></sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>io.quarkus.platform</groupId>
                        <artifactId>quarkus-maven-plugin</artifactId>
                        <configuration>
                            <!-- Dev-mode defaults for the helpers that still use in-service simulation. -->
                            <systemProperties>
                                <starter.power-actions.enabled>false</starter.power-actions.enabled>
                                <starter.mdns.enabled>false</starter.mdns.enabled>
                                <starter.data-dir>${project.build.directory}/dev-data</starter.data-dir>
                            </systemProperties>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>simulation-test-sources</id>
                        <phase>generate-test-sources</phase>
                        <goals><goal>add-test-source</goal></goals>
                        <configuration>
                            <skipAddTestSource>${simulation.skipTestSources}</skipAddTestSource>
                            <sources><source>src/simulation/java</source></sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.version}</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                            <goal>generate-code-tests</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
                <configuration>
                    <!-- Surefire enables Java assertions; Vaadin's element state provider asserts
                         lower-case attribute names, which the SVG sparkline (viewBox) violates
                         on purpose. Production never runs with assertions. -->
                    <enableAssertions>false</enableAssertions>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.4</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <systemPropertyVariables>
                        <quarkus.test.integration-test-profile>it</quarkus.test.integration-test-profile>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <!-- The PWA icon, rendered from the logo SVG and packaged as a resource. -->
                <groupId>in.virit</groupId>
                <artifactId>svg-render-maven-plugin</artifactId>
                <version>1.0.0-SNAPSHOT</version>
                <executions>
                    <execution>
                        <goals><goal>render</goal></goals>
                        <configuration>
                            <images>
                                <image>
                                    <source>src/main/resources/META-INF/resources/icons/logo.svg</source>
                                    <output>META-INF/resources/icons/icon.png</output>
                                    <width>512</width>
                                    <height>512</height>
                                </image>
                            </images>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
