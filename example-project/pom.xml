<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>in.virit.iot</groupId>
        <artifactId>pi-starter-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>pi-starter</artifactId>
    <name>Pi Starter</name>
    <properties>
        <jairosvg.version>1.0.14</jairosvg.version>
        <simulation.skipTestSources>false</simulation.skipTestSources>
    </properties>
    <dependencies>
        <dependency>
            <groupId>in.virit.iot</groupId>
            <artifactId>pi-helpers</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-quarkus-extension</artifactId>
            <version>${vaadin.version}</version>
        </dependency>
        <dependency>
            <groupId>in.virit</groupId>
            <artifactId>viritin</artifactId>
            <version>3.8.1</version>
        </dependency>
        <!-- Hardware dependencies are used only by the LED example. -->
        <dependency>
            <groupId>com.pi4j</groupId>
            <artifactId>pi4j-core</artifactId>
            <version>${pi4j.version}</version>
        </dependency>
        <dependency>
            <groupId>com.pi4j</groupId>
            <artifactId>pi4j-plugin-ffm</artifactId>
            <version>${pi4j.version}</version>
        </dependency>
        <!-- The BME280 example: the sensor driver plus the gauge and sparkline the
             climate card is drawn with (the same ones ScrewCloud's pi-reader uses). -->
        <dependency>
            <groupId>com.pi4j</groupId>
            <artifactId>pi4j-drivers</artifactId>
            <version>1.1.0</version>
        </dependency>
        <dependency>
            <groupId>in.virit</groupId>
            <artifactId>gauge</artifactId>
            <version>1.2.0</version>
        </dependency>
        <dependency>
            <groupId>in.virit</groupId>
            <artifactId>svg-visualizations</artifactId>
            <version>1.1.0</version>
        </dependency>
        <!-- The Bluetooth LE scanner talks to BlueZ over the system D-Bus. -->
        <dependency>
            <groupId>com.github.hypfvieh</groupId>
            <artifactId>bluez-dbus</artifactId>
            <version>0.3.2</version>
        </dependency>
        <dependency>
            <groupId>com.github.hypfvieh</groupId>
            <artifactId>dbus-java-transport-native-unixsocket</artifactId>
            <version>5.1.1</version>
        </dependency>
        <!-- Publishing to Home Assistant: MQTT client and mDNS lookup of the instance. -->
        <dependency>
            <groupId>com.hivemq</groupId>
            <artifactId>hivemq-mqtt-client</artifactId>
            <version>1.4.0</version>
        </dependency>
        <dependency>
            <groupId>org.jmdns</groupId>
            <artifactId>jmdns</artifactId>
            <version>3.6.3</version>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-validator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Browserless UI tests: real views in a mocked Vaadin environment inside the
             Quarkus test container, no browser and no frontend build. -->
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>browserless-test-quarkus</artifactId>
            <version>1.1.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>1.62.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <profiles>
        <profile>
            <id>simulation</id>
            <properties>
                <!-- These sources are already compiled as application classes in this profile. -->
                <simulation.skipTestSources>true</simulation.skipTestSources>
            </properties>
            <build>
                <!-- Never leave simulated application classes in the production output tree. -->
                <directory>target/simulation</directory>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>simulation-dev-sources</id>
                                <phase>generate-sources</phase>
                                <goals><goal>add-source</goal></goals>
                                <configuration>
                                    <sources><source>src/simulation/java</source></sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>io.quarkus.platform</groupId>
                        <artifactId>quarkus-maven-plugin</artifactId>
                        <configuration>
                            <!-- Dev-mode defaults for the helpers that still use in-service simulation. -->
                            <systemProperties>
                                <starter.hardware.simulated>true</starter.hardware.simulated>
                                <starter.power-actions.enabled>false</starter.power-actions.enabled>
                                <starter.mdns.enabled>false</starter.mdns.enabled>
                                <starter.data-dir>${project.build.directory}/dev-data</starter.data-dir>
                            </systemProperties>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.build.directory}/generated-resources/pwa</directory>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>simulation-test-sources</id>
                        <phase>generate-test-sources</phase>
                        <goals><goal>add-test-source</goal></goals>
                        <configuration>
                            <skipAddTestSource>${simulation.skipTestSources}</skipAddTestSource>
                            <sources><source>src/simulation/java</source></sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.version}</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                            <goal>generate-code-tests</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
                <configuration>
                    <!-- Surefire enables Java assertions; Vaadin's element state provider asserts
                         lower-case attribute names, which the SVG sparkline (viewBox) violates
                         on purpose. Production never runs with assertions. -->
                    <enableAssertions>false</enableAssertions>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.4</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <systemPropertyVariables>
                        <quarkus.test.integration-test-profile>it</quarkus.test.integration-test-profile>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                <dependencies>
                    <dependency>
                        <groupId>io.brunoborges</groupId>
                        <artifactId>jairosvg</artifactId>
                        <version>${jairosvg.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>generate-pwa-icon</id>
                        <phase>generate-resources</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <includePluginDependencies>true</includePluginDependencies>
                            <addOutputToClasspath>false</addOutputToClasspath>
                            <arguments>
                                <argument>-Djava.awt.headless=true</argument>
                                <argument>--class-path</argument>
                                <classpath>
                                    <dependency>io.brunoborges:jairosvg</dependency>
                                    <dependency>in.virit:color</dependency>
                                </classpath>
                                <argument>${project.basedir}/src/build/GeneratePwaIcon.java</argument>
                                <argument>${project.basedir}/src/main/resources/META-INF/resources/icons/pi-starter.svg</argument>
                                <argument>${project.build.directory}/generated-resources/pwa/META-INF/resources/icons/icon.png</argument>
                                <argument>${project.build.directory}/pwa-icon.sha256</argument>
                                <argument>${project.basedir}/src/build/GeneratePwaIcon.java</argument>
                                <argument>${jairosvg.version}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <classpathScope>test</classpathScope>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
